TENANT_ID=
CLIENT_ID=

# Legacy (currently ignored): scheduling now uses rolling windows from
# now or active role end-time instead of fixed timezone slots.
PIM_TIMEZONE=

# Keep this many future windows scheduled per role.
PIM_FUTURE_WINDOWS=4

# Window length in hours (your tenant limit is 8).
PIM_ACTIVATION_DURATION_HOURS=8

# Optional log file path (relative paths are resolved from script folder).
PIM_LOG_FILE=./pimelim.log

# Role configuration (add more by incrementing index)
PIM_ROLE_1_NAME=Application Administrator
PIM_ROLE_1_REASON=Need emergency admin access outside work network

PIM_ROLE_2_NAME=SharePoint Administrator
PIM_ROLE_2_REASON=Need SharePoint admin access outside work network
