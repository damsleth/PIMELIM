TENANT_ID=
CLIENT_ID=

# Optional (default: true)
NOW=true

# Optional (default: 36)
# Target coverage horizon (hours) from scheduling anchor.
# Anchor is now when NOW=true, or now + duration when NOW=false for inactive roles.
COVER_FOR_HOURS=36

# Optional (default: 8)
# Activation window length in hours.
ACTIVATION_DURATION_HOURS=8

# Optional (default: 60)
# Seconds added between consecutive scheduled windows to avoid Graph overlap errors.
# PIM compares pending request windows at minute granularity, so values below 60
# are effectively raised to the next whole-minute boundary.
ACTIVATION_TIME_BUFFER=60

# Optional (default: 5)
# Smallest activation window worth scheduling; free gaps shorter than this are left
# unscheduled. Clamped to >= 5, the minimum activation duration PIM accepts.
MINIMUM_WINDOW_MINUTES=5

# Optional (default: ./pimelim.log)
# Relative paths are resolved from the script folder.
LOG_FILE=./pimelim.log

# Required role blocks (add more by incrementing index)
ROLE_1_NAME=Application Administrator
ROLE_1_REASON=Need emergency admin access outside work network

ROLE_2_NAME=SharePoint Administrator
ROLE_2_REASON=Need SharePoint admin access outside work network
